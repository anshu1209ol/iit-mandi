# ========================================================================
# IIT Mandi Themed Hackathon 2026 - Supabase Environment Configuration
# ========================================================================

# 1. Public Browser Client Credentials (Exposed to Vite frontend)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Server-Side Administrative Credentials (STRICTLY CONFIDENTIAL)
# NEVER prefix with VITE_. Never expose in browser code or client commits.
# Used for server-side migrations, seed scripts, and privileged admin mutations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. Application Timezone (Strictly Centralized)
VITE_EVENT_TIMEZONE=Asia/Kolkata
